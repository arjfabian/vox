instance/*
!instance/.gitkeep

# Master Identity Profiles
identity/*
!identity/.gitkeep

# Runtime Operations, Traces & Caches
logs/*
!logs/.gitkeep
var/cache/

# Project Documentation
wiki/
docs/internal/

# VOX — System-level environment variables
# Copy this file to .env and fill in your values.
#
# Agent-specific variables (AGENT_TELEGRAM_TOKEN, OLLAMA_*, TELEGRAM_*, etc.)
# belong in each agent's own agents/<name>/.env file.

# Telegram chat ID for the War Room — the shared emergency channel
# where all agents can post alerts regardless of their individual configuration.
# How to get it: create a Telegram group, add your bot, then send a message
# and read the chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates
VOX_WAR_ROOM_ID=
